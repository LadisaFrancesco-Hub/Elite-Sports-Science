{
  "appId": "com.elitesportsscience.coachos",
  "appName": "CoachOS",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "ncvmnoaelzdmuiqrvcjl.supabase.co",
      "*.supabase.co",
      "cdnjs.cloudflare.com",
      "cdn.jsdelivr.net"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#05070A"
    }
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
